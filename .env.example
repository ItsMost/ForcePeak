# Supabase (Vercel: Project Settings > Environment Variables)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: hidden login account for the single-coach passcode login (default coach@peakforce.app)
# VITE_COACH_LOGIN_EMAIL=coach@peakforce.app

# Optional, ONLY for backup/export.mjs on your own machine. Never prefix with VITE_.
# SUPABASE_BACKUP_KEY=
